# Copy this file to local/.env and populate values from Infisical.
# Never commit local/.env.

# Canva (read-only by default)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_TEST_FOLDER_ID=
CANVA_ALLOW_WRITES=false

# Higgsfield REST API (optional; CLI is authenticated separately)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_SECRET=

# Magnific
MAGNIFIC_API_KEY=
MAGNIFIC_WEBHOOK_SECRET=

# Infisical (used by helper scripts to pull other secrets)
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SERVICE_TOKEN=

# Paths (override only if the manifest moves)
AGENTS_WORKSPACE_ROOT=/Users/Shared/Agents/agents
AGENTS_NODE_PREFIX=/Users/Shared/Agents/.node
