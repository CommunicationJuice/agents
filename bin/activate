#!/bin/zsh
# activate — source this file to put the shared Art 2 agent tooling on PATH
export AGENTS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")/.." && pwd)"
export PATH="$AGENTS_ROOT/.node/bin:$AGENTS_ROOT/bin:$PATH"
export AGENTS_NODE_PREFIX="${AGENTS_ROOT}/.node"
export AGENTS_WORKSPACE_ROOT="$AGENTS_ROOT"

# Convenience aliases
alias agents-update="$AGENTS_ROOT/scripts/update.sh"
alias agents-install="$AGENTS_ROOT/scripts/install.sh"

echo "Agent workspace activated: $AGENTS_ROOT"
echo "Node: $(node --version 2>/dev/null || echo 'not installed')"
echo "Hyperframes: $(hyperframes --version 2>/dev/null || echo 'not installed')"
